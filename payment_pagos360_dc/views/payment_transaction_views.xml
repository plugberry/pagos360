<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_transaction_form_dc" model="ir.ui.view">
        <field name="name">payment.transaction.form (Director's Cut)</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <field name="provider_reference" position="after">
                <field name="pagos360_adhesion_type" invisible="1"/>
                <field name="pagos360_debit_execution_date"
                       invisible="pagos360_adhesion_type not in ('adhesion', 'card_adhesion')"/>
            </field>
        </field>
    </record>

</odoo>
