<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form_dc" model="ir.ui.view">
        <field name="name">Pagos 360 Provider Form (Director's Cut)</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment_pagos360.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='fees_and_due_dates']" position="inside">
                <group string="Cupón de efectivo (Pago Fácil / Rapipago)">
                    <field name="pagos360_coupon_validity_days"/>
                </group>
                <group string="Débito en tarjeta (TC)" invisible="not allow_tokenization">
                    <field name="pagos360_cut_days"/>
                </group>
                <group string="Débito bancario (CBU)" invisible="not allow_tokenization">
                    <field name="pagos360_debit_use_invoice_due" widget="boolean_toggle"/>
                    <field name="pagos360_debit_execution_days"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
