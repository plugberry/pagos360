<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_transaction_form_pagos360" model="ir.ui.view">
        <field name="name">payment.transaction.form.pagos360</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='provider_reference']" position="after">
                <field name="pagos360_adhesion_type"
                       invisible="provider_code != 'pagos360'"/>
                <field name="pagos360_effective_payment_date"
                       invisible="provider_code != 'pagos360'"/>
                <field name="pagos360_debit_execution_date"
                       invisible="provider_code != 'pagos360' or not pagos360_debit_execution_date"/>
                <field name="pagos360_child_amount"
                       invisible="provider_code != 'pagos360' or not pagos360_child_amount"/>
                <field name="pagos360_estimated_charge_date"
                       invisible="provider_code != 'pagos360'"/>
                <field name="pagos360_estimated_settlement_date"
                       invisible="provider_code != 'pagos360'"/>
            </xpath>
        </field>
    </record>

    <record id="action_info_from_pagos360" model="ir.actions.server">
        <field name="name">Check in (PAGOS360)</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">action = records.get_pagos360_info()</field>
        <field name="binding_model_id" ref="payment.model_payment_transaction"/>
        <field name="binding_type">action</field>
    </record>

    <record id="action_pagos360_cancel_transaction" model="ir.actions.server">
        <field name="name">Cancelar Transaccion (PAGOS360)</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">action = records.pagos360_cancel_transactions()</field>
        <field name="binding_model_id" ref="payment.model_payment_transaction"/>
        <field name="binding_type">action</field>
    </record>
</odoo>
