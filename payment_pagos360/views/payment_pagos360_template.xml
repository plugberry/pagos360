<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <!-- Pagos360 generates a unique URL for each payment request. -->
        <form t-att-action="api_url" method="post"/>
    </template>

    <template id="inline_form">
        <div class="alert alert-warning" role="alert">
            Usted será redirigido al sitio web de PAGOS360.
            <p style="font-size: 14px;">
            Ante algún inconveniente al realizar su pago contactese a
            <a href="mailto:hola@pagos360.com">hola@pagos360.com</a>
            </p>
        </div>
    </template>
    <template id="rapipago_barcode_print" name="Pagos 360 barcode_print">
        <t t-set="no_breadcrumbs" t-value="True"/>
        <t t-call="portal.portal_layout">
            <h1>Pagar Mediante Rapipago</h1>
            <div>
            <p>Imprima este codigo para abonar en la red de rapipago</p>
            <img t-attf-src="https://api.pagos360.com/payment-request/barcode/barcode_print/{barcode}"/>
            </div>
        </t>
    </template>
</odoo>
