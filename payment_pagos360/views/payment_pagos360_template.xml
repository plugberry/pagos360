<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="redirect_form">
        <!-- Pagos360 generates a unique URL for each payment request. -->
        <form t-att-action="api_url" method="post"/>
    </template>

    <template id="inline_form">
        <div class="alert alert-warning" role="alert">
            Usted será redirigido al sitio web de PAGOS360.
            <p style="font-size: 14px;">
            Ante algún inconveniente al realizar su pago contactese a
            <a href="mailto:hola@pagos360.com">hola@pagos360.com</a>
            </p>
        </div>
    </template>

</odoo>
