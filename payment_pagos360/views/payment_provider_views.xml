<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Pagos 360 Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="before">
                <div attrs="{'invisible': [('code', '!=', 'pagos360')]}">
                    <button string="Ensure Webhook" type="object" name="ensure_webhook" class="btn-primary mb-3" colspan="2" />
                </div>
            </group>
            <group name="provider_credentials" position='inside'>
                <group attrs="{'invisible': [('code', '!=', 'pagos360')]}">
                    <field name="pagos360_api_key" password="True"
                           attrs="{'required':[('code', '=', 'pagos360'), ('state', '=', 'enabled')], 'invisible':[('state', '!=', 'enabled')]}"/>
                    <field name="pagos360_test_api_key" password="True"
                           attrs="{'required':[('code', '=', 'pagos360'), ('state', '=', 'test')], 'invisible':[('state', '!=', 'test')]}"/>
                </group>
            </group>
            <xpath expr="//page[@name='configuration']" position="after">
                <page string="Fees and Due dates" name="fees_and_due_dates" attrs="{'invisible': [('code', '!=', 'pagos360')]}">
                    <group name="fees_and_due_dates">
                        <field name="validity_days"/>
                        <!-- <field name="second_validity_days"/>
                        <label for="second_due_fees"/>
                        <div>
                            <field name="second_due_fees"/> %
                        </div> -->
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
