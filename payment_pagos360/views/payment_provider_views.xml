<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">Pagos 360 Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="before">
                <div invisible="code != 'pagos360'">
                    <button string="Ensure Webhook" type="object" name="ensure_webhook" class="btn-primary mb-3" colspan="2" />
                </div>
            </group>
            <group name="provider_credentials" position='inside'>
                <group invisible="code != 'pagos360'">
                    <field name="pagos360_api_key" password="True"
                           invisible="state != 'enabled'"/>
                    <field name="pagos360_test_api_key" password="True"
                           invisible="state != 'test'"/>
                </group>
            </group>
            <field name="allow_tokenization" position="after">
                <field name="pagos360_form_url"
                       invisible="code != 'pagos360' or not allow_tokenization"
                       required="code == 'pagos360' and state in ('enabled', 'test') and allow_tokenization"/>
            </field>
            <xpath expr="//page[@name='configuration']" position="after">
                <page string="Fees and Due dates" name="fees_and_due_dates" invisible="code != 'pagos360'">
                    <group name="fees_and_due_dates">
                        <group string="Cupón de efectivo (Pago Fácil / Rapipago)">
                            <field name="pagos360_coupon_validity_days"/>
                        </group>
                        <group string="Débito en tarjeta (TC)" invisible="not allow_tokenization">
                            <field name="pagos360_cut_days"/>
                        </group>
                        <group string="Débito bancario (CBU)" invisible="not allow_tokenization">
                            <field name="pagos360_debit_use_invoice_due" widget="boolean_toggle"/>
                            <field name="pagos360_debit_execution_days"/>
                        </group>
                        <group string="Canales y restricciones">
                            <field name="pagos360_excluded_channels"/>
                            <field name="pagos360_excluded_installments"/>
                            <field name="pagos360_excluded_card_brands"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
