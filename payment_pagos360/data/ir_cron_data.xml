<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- 04:00 UTC is 01:00 in Argentina, when the day before is already closed. -->
    <record id="ir_cron_pagos360_collection_control" model="ir.cron">
        <field name="name">Pagos360: Daily Collection Control</field>
        <field name="model_id" ref="payment.model_payment_transaction"/>
        <field name="state">code</field>
        <field name="code">model._cron_pagos360_collection_control()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now().replace(hour=4, minute=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active">True</field>
    </record>

</odoo>
